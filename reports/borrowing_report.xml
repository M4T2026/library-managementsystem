<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Borrowing Slip Report -->
    <record id="action_report_borrowing" model="ir.actions.report">
        <field name="name">Borrowing Slip</field>
        <field name="model">library.borrowing</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_management.report_borrowing_slip_document</field>
        <field name="report_file">library_management.report_borrowing_slip_document</field>
        <field name="print_report_name">'Borrowing Slip - ' + object.name</field>
        <field name="binding_model_id" ref="model_library_borrowing"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Borrowing List Report -->
    <record id="action_report_borrowing_list" model="ir.actions.act_window">
        <field name="name">Borrowing Report</field>
        <field name="res_model">library.borrowing</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
