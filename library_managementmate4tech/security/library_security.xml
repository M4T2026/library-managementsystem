<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_library_user" model="res.groups">
        <field name="name">Library: Librarian</field>
        <field name="comment">Can manage loans, members and copies.</field>
    </record>

    <record id="group_library_manager" model="res.groups">
        <field name="name">Library: Manager</field>
        <field name="comment">Full access, including the catalogue and configuration.</field>
        <field name="implied_ids" eval="[(4, ref('group_library_user'))]"/>
    </record>

    <!-- Administrators automatically get library manager rights -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_library_manager'))]"/>
    </record>
</odoo>
