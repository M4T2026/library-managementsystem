<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_library_loan" model="ir.sequence">
            <field name="name">Library Loan</field>
            <field name="code">library.loan</field>
            <field name="prefix">LOAN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_library_member" model="ir.sequence">
            <field name="name">Library Member</field>
            <field name="code">library.member</field>
            <field name="prefix">MEM</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_library_book_copy" model="ir.sequence">
            <field name="name">Library Book Copy</field>
            <field name="code">library.book.copy</field>
            <field name="prefix">BC</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Default policies (editable in Settings > Technical > System Parameters) -->
        <record id="param_loan_days" model="ir.config_parameter">
            <field name="key">library.loan_days</field>
            <field name="value">14</field>
        </record>
        <record id="param_fine_per_day" model="ir.config_parameter">
            <field name="key">library.fine_per_day</field>
            <field name="value">1.0</field>
        </record>
        <record id="param_max_renewals" model="ir.config_parameter">
            <field name="key">library.max_renewals</field>
            <field name="value">2</field>
        </record>
    </data>

    <record id="ir_cron_library_overdue" model="ir.cron">
        <field name="name">Library: Update Overdue Loans</field>
        <field name="model_id" ref="model_library_loan"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_overdue()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
