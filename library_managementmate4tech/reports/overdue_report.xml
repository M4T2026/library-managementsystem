<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Overdue Report PDF -->
    <record id="action_report_overdue" model="ir.actions.report">
        <field name="name">Overdue Books Report</field>
        <field name="model">library.borrowing</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">library_management.report_overdue_document</field>
        <field name="report_file">library_management.report_overdue_document</field>
        <field name="print_report_name">'Overdue Report'</field>
    </record>

    <!-- Overdue Report List View -->
    <record id="action_report_overdue_list" model="ir.actions.act_window">
        <field name="name">Overdue Report</field>
        <field name="res_model">library.borrowing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'overdue')]</field>
        <field name="context">{}</field>
    </record>

</odoo>
