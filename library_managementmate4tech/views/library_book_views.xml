<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Book Kanban View -->
    <record id="library_book_view_kanban" model="ir.ui.view">
        <field name="name">library.book.view.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban default_order="name" sample="1" class="o_library_book_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="image"/>
                <field name="author_ids"/>
                <field name="category_id"/>
                <field name="state"/>
                <field name="available_copies"/>
                <field name="total_copies"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record o_library_book_card" t-att-class="'oe_kanban_global_click'">
                            <div class="o_kanban_image_fill o_library_book_cover" role="img">
                                <img t-if="record.image.raw_value"
                                    t-att-src="kanban_image('library.book', 'image', record.id.raw_value)"
                                    class="o_image_full_cover" alt="Book Cover"/>
                                <div t-else="" class="o_kanban_image_placeholder o_library_book_cover_placeholder">
                                    <i class="fa fa-book" style="font-size:3rem;color:#7c7bad;"/>
                                </div>
                                <div class="o_library_book_status_badge">
                                    <span t-attf-class="badge #{record.state.raw_value == 'available' ? 'text-bg-success' : record.state.raw_value == 'borrowed' ? 'text-bg-warning' : 'text-bg-danger'}">
                                        <field name="state"/>
                                    </span>
                                </div>
                            </div>
                            <div class="oe_kanban_details p-2">
                                <strong class="o_kanban_record_title d-block text-truncate">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted small">
                                    <field name="author_ids" widget="many2many_tags"/>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-1">
                                    <span class="badge text-bg-primary"><field name="category_id"/></span>
                                    <small><i class="fa fa-copy"/> <field name="available_copies"/>/<field name="total_copies"/></small>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Book List View -->
    <record id="library_book_view_list" model="ir.ui.view">
        <field name="name">library.book.view.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list string="Books"
                  decoration-success="state == 'available'"
                  decoration-warning="state == 'borrowed'"
                  decoration-danger="state in ('lost', 'damaged')"
                  decoration-muted="not active">
                <field name="image" widget="image" options="{'size': [32, 32]}"/>
                <field name="ref"/>
                <field name="name"/>
                <field name="author_ids" widget="many2many_tags"/>
                <field name="category_id"/>
                <field name="publisher_id"/>
                <field name="publication_year"/>
                <field name="available_copies"/>
                <field name="total_copies"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'borrowed'"
                       decoration-danger="state in ('lost', 'damaged')"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Book Form View -->
    <record id="library_book_view_form" model="ir.ui.view">
        <field name="name">library.book.view.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <header>
                    <button name="action_mark_lost" string="Mark as Lost"
                            type="object" class="btn-secondary"
                            invisible="state == 'lost'"/>
                    <button name="action_mark_available" string="Mark Available"
                            type="object" class="btn-primary"
                            invisible="state == 'available'"/>
                    <button name="action_view_borrowings" string="View Borrowings"
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,borrowed,returned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_borrowings" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="total_borrow_count" widget="statinfo" string="Borrows"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-copy" type="button">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="available_copies"/></span>
                                <span class="o_stat_text">Available</span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image', 'size': [200, 280]}"/>
                    <div class="oe_title">
                        <label class="o_form_label" for="ref">Reference</label>
                        <h6><field name="ref" readonly="1"/></h6>
                        <h1><field name="name" placeholder="Book Title"/></h1>
                        <field name="author_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}"
                               placeholder="Add authors..."/>
                    </div>
                    <group>
                        <group string="Book Details">
                            <field name="isbn"/>
                            <field name="isbn13"/>
                            <field name="barcode"/>
                            <field name="category_id"/>
                            <field name="publisher_id"/>
                            <field name="language"/>
                            <field name="edition"/>
                            <field name="pages"/>
                            <field name="publication_year"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                        <group string="Inventory">
                            <field name="total_copies"/>
                            <field name="available_copies" readonly="1"/>
                            <field name="borrowed_copies" readonly="1"/>
                            <field name="reserved_copies" readonly="1"/>
                            <field name="location"/>
                            <field name="rack_number"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="short_description"
                                   placeholder="Brief description of the book..."/>
                            <separator string="Full Description"/>
                            <field name="description" placeholder="Full description..."/>
                        </page>
                        <page string="Borrowing History">
                            <field name="borrowing_ids" readonly="1">
                                <list decoration-warning="state=='overdue'"
                                      decoration-success="state=='returned'">
                                    <field name="name"/>
                                    <field name="member_id"/>
                                    <field name="borrow_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"
                                           decoration-warning="state=='overdue'"
                                           decoration-success="state=='returned'"/>
                                    <field name="fine_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Book Search View -->
    <record id="library_book_view_search" model="ir.ui.view">
        <field name="name">library.book.view.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search string="Search Books">
                <field name="name" string="Book Title"/>
                <field name="isbn"/>
                <field name="barcode"/>
                <field name="author_ids"/>
                <field name="category_id"/>
                <field name="publisher_id"/>
                <field name="ref"/>
                <separator/>
                <filter string="Available" name="available" domain="[('state','=','available')]"/>
                <filter string="Borrowed" name="borrowed" domain="[('state','=','borrowed')]"/>
                <filter string="Lost / Damaged" name="lost"
                        domain="[('state','in',['lost','damaged'])]"/>
                <separator/>
                <filter string="My Favorites" name="my_fav" domain="[]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Publisher" name="group_publisher" context="{'group_by': 'publisher_id'}"/>
                    <filter string="Language" name="group_language" context="{'group_by': 'language'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Book Action -->
    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="library_book_view_search"/>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first book to the library!
            </p>
            <p>Track books, manage copies, and monitor borrowing.</p>
        </field>
    </record>

</odoo>
