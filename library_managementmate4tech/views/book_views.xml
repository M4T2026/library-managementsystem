<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ BOOK ============ -->
    <record id="library_book_view_form" model="ir.ui.view">
        <field name="name">library.book.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_add_copy" string="Add Copy" type="object" class="btn-primary"
                            invisible="not id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_loans" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="loan_count" widget="statinfo" string="Loans"/>
                        </button>
                    </div>
                    <field name="cover" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. The Pragmatic Programmer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="isbn"/>
                            <field name="author_ids" widget="many2many_tags" options="{'color_field': 'id', 'no_create_edit': False}"/>
                            <field name="category_id"/>
                            <field name="language"/>
                        </group>
                        <group>
                            <field name="publisher"/>
                            <field name="publication_year" options="{'format': false}"/>
                            <field name="pages"/>
                            <field name="price"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Copies" name="copies">
                            <field name="copy_ids" context="{'default_book_id': id}">
                                <list editable="bottom">
                                    <field name="barcode" placeholder="Auto"/>
                                    <field name="state"/>
                                    <field name="acquisition_date"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="library_book_view_list" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="isbn" optional="show"/>
                <field name="author_ids" widget="many2many_tags"/>
                <field name="category_id"/>
                <field name="publisher" optional="hide"/>
                <field name="publication_year" optional="hide" options="{'format': false}"/>
                <field name="copy_count" string="Copies"/>
                <field name="available_count" string="Available"/>
            </list>
        </field>
    </record>

    <record id="library_book_view_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <aside>
                            <field name="cover" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main class="ps-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="author_ids" widget="many2many_tags"/>
                            <field name="category_id" class="text-muted"/>
                            <div>
                                Available: <field name="available_count"/> / <field name="copy_count"/>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="library_book_view_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Title / ISBN" filter_domain="['|', ('name', 'ilike', self), ('isbn', 'ilike', self)]"/>
                <field name="author_ids"/>
                <field name="category_id"/>
                <field name="publisher"/>
                <filter name="available" string="Available" domain="[('available_count', '>', 0)]"/>
                <filter name="unavailable" string="Not Available" domain="[('available_count', '=', 0)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_publisher" string="Publisher" context="{'group_by': 'publisher'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first book</p>
            <p>Create the catalogue entry, then add physical copies from the book form.</p>
        </field>
    </record>

    <!-- ============ COPY ============ -->
    <record id="library_book_copy_view_list" model="ir.ui.view">
        <field name="name">library.book.copy.list</field>
        <field name="model">library.book.copy</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'available'" decoration-info="state == 'borrowed'"
                  decoration-danger="state == 'lost'" decoration-warning="state == 'maintenance'">
                <field name="barcode"/>
                <field name="book_id"/>
                <field name="state" widget="badge"/>
                <field name="acquisition_date"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="library_book_copy_view_form" model="ir.ui.view">
        <field name="name">library.book.copy.form</field>
        <field name="model">library.book.copy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="book_id"/>
                            <field name="barcode" placeholder="Auto"/>
                        </group>
                        <group>
                            <field name="acquisition_date"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Loan History">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="member_id"/>
                                    <field name="loan_date"/>
                                    <field name="return_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_book_copy_view_search" model="ir.ui.view">
        <field name="name">library.book.copy.search</field>
        <field name="model">library.book.copy</field>
        <field name="arch" type="xml">
            <search>
                <field name="barcode"/>
                <field name="book_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="borrowed" string="Borrowed" domain="[('state', '=', 'borrowed')]"/>
                <filter name="lost" string="Lost" domain="[('state', '=', 'lost')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_book" string="Book" context="{'group_by': 'book_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="library_book_copy_action" model="ir.actions.act_window">
        <field name="name">Copies</field>
        <field name="res_model">library.book.copy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ AUTHOR ============ -->
    <record id="library_author_view_form" model="ir.ui.view">
        <field name="name">library.author.form</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <notebook>
                        <page string="Biography"><field name="biography"/></page>
                        <page string="Books"><field name="book_ids" widget="many2many" readonly="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="library_author_view_list" model="ir.ui.view">
        <field name="name">library.author.list</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="book_count"/>
            </list>
        </field>
    </record>

    <record id="library_author_action" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ CATEGORY ============ -->
    <record id="library_category_view_list" model="ir.ui.view">
        <field name="name">library.category.list</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="book_count"/>
            </list>
        </field>
    </record>

    <record id="library_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">library.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
