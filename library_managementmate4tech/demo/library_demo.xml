<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="demo_categ_tech" model="library.category"><field name="name">Technology</field></record>
    <record id="demo_categ_fiction" model="library.category"><field name="name">Fiction</field></record>
    <record id="demo_categ_history" model="library.category"><field name="name">History</field></record>

    <record id="demo_author_hunt" model="library.author"><field name="name">Andrew Hunt</field></record>
    <record id="demo_author_thomas" model="library.author"><field name="name">David Thomas</field></record>
    <record id="demo_author_orwell" model="library.author"><field name="name">George Orwell</field></record>
    <record id="demo_author_harari" model="library.author"><field name="name">Yuval Noah Harari</field></record>

    <record id="demo_book_pragmatic" model="library.book">
        <field name="name">The Pragmatic Programmer</field>
        <field name="isbn">9780135957059</field>
        <field name="author_ids" eval="[(6, 0, [ref('demo_author_hunt'), ref('demo_author_thomas')])]"/>
        <field name="category_id" ref="demo_categ_tech"/>
        <field name="publisher">Addison-Wesley</field>
        <field name="publication_year">2019</field>
        <field name="price">45</field>
    </record>
    <record id="demo_book_1984" model="library.book">
        <field name="name">1984</field>
        <field name="isbn">9780451524935</field>
        <field name="author_ids" eval="[(6, 0, [ref('demo_author_orwell')])]"/>
        <field name="category_id" ref="demo_categ_fiction"/>
        <field name="publisher">Signet Classic</field>
        <field name="publication_year">1950</field>
        <field name="price">12</field>
    </record>
    <record id="demo_book_sapiens" model="library.book">
        <field name="name">Sapiens: A Brief History of Humankind</field>
        <field name="isbn">9780062316097</field>
        <field name="author_ids" eval="[(6, 0, [ref('demo_author_harari')])]"/>
        <field name="category_id" ref="demo_categ_history"/>
        <field name="publisher">Harper</field>
        <field name="publication_year">2015</field>
        <field name="price">20</field>
    </record>

    <record id="demo_copy_pragmatic_1" model="library.book.copy"><field name="book_id" ref="demo_book_pragmatic"/></record>
    <record id="demo_copy_pragmatic_2" model="library.book.copy"><field name="book_id" ref="demo_book_pragmatic"/></record>
    <record id="demo_copy_1984_1" model="library.book.copy"><field name="book_id" ref="demo_book_1984"/></record>
    <record id="demo_copy_sapiens_1" model="library.book.copy"><field name="book_id" ref="demo_book_sapiens"/></record>

    <record id="demo_partner_alice" model="res.partner">
        <field name="name">Alice Reader</field>
        <field name="email">alice.reader@example.com</field>
    </record>
    <record id="demo_partner_bob" model="res.partner">
        <field name="name">Bob Bookworm</field>
        <field name="email">bob.bookworm@example.com</field>
    </record>
    <record id="demo_member_alice" model="library.member">
        <field name="partner_id" ref="demo_partner_alice"/>
    </record>
    <record id="demo_member_bob" model="library.member">
        <field name="partner_id" ref="demo_partner_bob"/>
    </record>
</odoo>
