<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category List View -->
    <record id="library_category_view_list" model="ir.ui.view">
        <field name="name">library.category.view.list</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <list string="Categories" decoration-muted="not active">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="book_count"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Category Form View -->
    <record id="library_category_view_form" model="ir.ui.view">
        <field name="name">library.category.view.form</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_books" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="book_count" widget="statinfo" string="Books"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Fiction"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                    <field name="child_ids" string="Sub-Categories">
                        <list>
                            <field name="name"/>
                            <field name="book_count"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Category Search View -->
    <record id="library_category_view_search" model="ir.ui.view">
        <field name="name">library.category.view.search</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <search string="Search Categories">
                <field name="name" string="Category"/>
                <field name="parent_id"/>
                <filter string="Top Level" name="top_level" domain="[('parent_id','=',False)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Parent Category" name="group_parent" context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Category Action -->
    <record id="library_category_action" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">library.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="library_category_view_search"/>
    </record>

</odoo>
