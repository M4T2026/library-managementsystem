<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Member Kanban View -->
    <record id="library_member_view_kanban" model="ir.ui.view">
        <field name="name">library.member.view.kanban</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <kanban sample="1" class="o_library_member_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="image"/>
                <field name="member_ref"/>
                <field name="membership_type"/>
                <field name="state"/>
                <field name="current_borrowing_count"/>
                <field name="fine_balance"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click o_library_member_card">
                            <div class="d-flex align-items-center p-2 gap-2">
                                <div class="o_kanban_image flex-shrink-0">
                                    <img t-if="record.image.raw_value"
                                        t-att-src="kanban_image('library.member', 'image', record.id.raw_value)"
                                        class="rounded-circle" style="width:56px;height:56px;object-fit:cover" alt="Member"/>
                                    <div t-else="" class="rounded-circle d-flex align-items-center justify-content-center"
                                         style="width:56px;height:56px;background:#7c7bad">
                                        <i class="fa fa-user" style="font-size:1.5rem;color:#fff"/>
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <strong class="d-block text-truncate"><field name="name"/></strong>
                                    <small class="text-muted"><field name="member_ref"/></small>
                                    <div class="mt-1">
                                        <span t-attf-class="badge #{record.state.raw_value == 'active' ? 'text-bg-success' : record.state.raw_value == 'suspended' ? 'text-bg-warning' : 'text-bg-danger'}">
                                            <field name="state"/>
                                        </span>
                                        <span class="badge text-bg-info ms-1">
                                            <field name="membership_type"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom p-2 border-top d-flex justify-content-between">
                                <span><i class="fa fa-book"/> <field name="current_borrowing_count"/> Active</span>
                                <span t-if="record.fine_balance.raw_value > 0" class="text-danger">
                                    <i class="fa fa-money"/> Fine: <field name="fine_balance" widget="monetary"/>
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Member List View -->
    <record id="library_member_view_list" model="ir.ui.view">
        <field name="name">library.member.view.list</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <list string="Members"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'suspended'"
                  decoration-danger="state in ('blacklisted', 'expired')"
                  decoration-muted="not active">
                <field name="image" widget="image" options="{'size': [32, 32]}"/>
                <field name="member_ref"/>
                <field name="name"/>
                <field name="membership_type" widget="badge"
                       decoration-info="membership_type == 'premium'"
                       decoration-success="membership_type == 'student'"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="membership_end"/>
                <field name="current_borrowing_count"/>
                <field name="fine_balance" widget="monetary" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'suspended'"
                       decoration-danger="state in ('blacklisted', 'expired')"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Member Form View -->
    <record id="library_member_view_form" model="ir.ui.view">
        <field name="name">library.member.view.form</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <form string="Library Member">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-success"
                            invisible="state == 'active'"/>
                    <button name="action_suspend" string="Suspend"
                            type="object" class="btn-warning"
                            invisible="state != 'active'"/>
                    <button name="action_blacklist" string="Blacklist"
                            type="object" class="btn-danger"
                            invisible="state == 'blacklisted'"/>
                    <button name="action_print_member_card" string="Print Member Card"
                            type="object" class="btn-secondary" icon="fa-id-card"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,suspended,expired,blacklisted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_borrowings" type="object"
                                class="oe_stat_button" icon="fa-exchange">
                            <field name="total_borrowing_count" widget="statinfo" string="Total Borrows"/>
                        </button>
                        <button name="action_view_borrowings" type="object"
                                class="oe_stat_button" icon="fa-book"
                                invisible="current_borrowing_count == 0">
                            <field name="current_borrowing_count" widget="statinfo" string="Active Borrows"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="fine_balance == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-danger">
                                    <field name="fine_balance" widget="monetary"/>
                                </span>
                                <span class="o_stat_text">Outstanding Fine</span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label class="o_form_label" for="member_ref">Member ID</label>
                        <h6><field name="member_ref" readonly="1"/></h6>
                        <h1><field name="name" placeholder="Full Name"/></h1>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="age" readonly="1"/>
                            <field name="id_type"/>
                            <field name="id_number"/>
                        </group>
                        <group string="Contact">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                        </group>
                    </group>
                    <group>
                        <group string="Membership">
                            <field name="membership_type"/>
                            <field name="membership_start"/>
                            <field name="membership_end"/>
                            <field name="max_books_allowed" readonly="1"/>
                            <field name="barcode"/>
                        </group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="zip"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Borrowing History">
                            <field name="borrowing_ids" readonly="1">
                                <list decoration-warning="state=='overdue'"
                                      decoration-success="state=='returned'"
                                      decoration-danger="state=='lost'">
                                    <field name="name"/>
                                    <field name="book_id"/>
                                    <field name="borrow_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"/>
                                    <field name="fine_amount"/>
                                    <field name="fine_paid" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes about this member..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Member Search View -->
    <record id="library_member_view_search" model="ir.ui.view">
        <field name="name">library.member.view.search</field>
        <field name="model">library.member</field>
        <field name="arch" type="xml">
            <search string="Search Members">
                <field name="name"/>
                <field name="member_ref"/>
                <field name="email"/>
                <field name="phone"/>
                <separator/>
                <filter string="Active" name="active_members" domain="[('state','=','active')]"/>
                <filter string="Expired" name="expired" domain="[('state','=','expired')]"/>
                <filter string="Suspended" name="suspended" domain="[('state','=','suspended')]"/>
                <filter string="Blacklisted" name="blacklisted" domain="[('state','=','blacklisted')]"/>
                <separator/>
                <filter string="Has Outstanding Fines" name="has_fines" domain="[('fine_balance','>',0)]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Membership Type" name="group_membership"
                            context="{'group_by': 'membership_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Gender" name="group_gender" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Member Action -->
    <record id="library_member_action" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">library.member</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="library_member_view_search"/>
        <field name="context">{'search_default_active_members': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first library member!
            </p>
        </field>
    </record>

</odoo>
