<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════
         BORROWING SLIP REPORT
    ═══════════════════════════════════════════════════════ -->
    <template id="report_borrowing_slip_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-foreach="docs" t-as="o">
                    <div class="o_lib_report_slip">
                        <!-- Header -->
                        <div class="o_lib_report_header">
                            <div class="o_lib_report_logo">
                                <h2 class="text-primary"><i class="fa fa-book"/> Library Management</h2>
                                <p class="text-muted">Borrowing Slip</p>
                            </div>
                            <div class="text-end">
                                <h4 class="text-muted">REF: <t t-esc="o.name"/></h4>
                                <p>Date: <t t-esc="o.borrow_date" t-options='{"widget": "date"}'/></p>
                            </div>
                        </div>

                        <hr/>

                        <!-- Member & Book Info -->
                        <div class="row mt-3">
                            <div class="col-6">
                                <h5 class="text-primary">Member Information</h5>
                                <table class="table table-sm">
                                    <tr><td><b>Name</b></td><td><t t-esc="o.member_id.name"/></td></tr>
                                    <tr><td><b>Member ID</b></td><td><t t-esc="o.member_id.member_ref"/></td></tr>
                                    <tr><td><b>Membership</b></td><td><t t-esc="o.member_id.membership_type"/></td></tr>
                                    <tr><td><b>Phone</b></td><td><t t-esc="o.member_id.phone or 'N/A'"/></td></tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <h5 class="text-primary">Book Information</h5>
                                <table class="table table-sm">
                                    <tr><td><b>Title</b></td><td><t t-esc="o.book_id.name"/></td></tr>
                                    <tr><td><b>Author(s)</b></td>
                                        <td><t t-esc="', '.join(o.book_id.author_ids.mapped('name'))"/></td>
                                    </tr>
                                    <tr><td><b>ISBN</b></td><td><t t-esc="o.book_id.isbn or 'N/A'"/></td></tr>
                                    <tr><td><b>Category</b></td><td><t t-esc="o.book_id.category_id.name or 'N/A'"/></td></tr>
                                </table>
                            </div>
                        </div>

                        <!-- Borrowing Details -->
                        <div class="row mt-2">
                            <div class="col-12">
                                <h5 class="text-primary">Borrowing Details</h5>
                                <table class="table table-bordered">
                                    <tr class="bg-light">
                                        <th>Borrow Date</th>
                                        <th>Due Date</th>
                                        <th>Return Date</th>
                                        <th>Status</th>
                                        <th>Fine Amount</th>
                                        <th>Renewals</th>
                                    </tr>
                                    <tr>
                                        <td><t t-esc="o.borrow_date" t-options='{"widget": "date"}'/></td>
                                        <td><t t-esc="o.due_date" t-options='{"widget": "date"}'/></td>
                                        <td><t t-esc="o.return_date or 'Not returned'" t-options='{"widget": "date"}' t-if="o.return_date"/><t t-else="">Not returned</t></td>
                                        <td><span t-attf-class="badge #{o.state == 'returned' and 'bg-success' or o.state == 'overdue' and 'bg-danger' or 'bg-warning'}"><t t-esc="o.state.upper()"/></span></td>
                                        <td><t t-esc="'%.2f' % o.fine_amount"/></td>
                                        <td><t t-esc="o.renewal_count"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- Terms -->
                        <div class="mt-3 p-3 border border-secondary rounded">
                            <h6>Terms &amp; Conditions:</h6>
                            <ul class="small text-muted">
                                <li>Please return the book by the due date to avoid fines.</li>
                                <li>A fine of <t t-esc="o.fine_per_day"/> per day is charged for late returns.</li>
                                <li>Report any damage immediately to the librarian.</li>
                                <li>Renewals can be requested before the due date (max <t t-esc="o.max_renewals"/> times).</li>
                            </ul>
                        </div>

                        <!-- Signatures -->
                        <div class="row mt-4">
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #333; margin: 0 30px; padding-top: 5px;">
                                    <p>Librarian Signature</p>
                                    <p class="text-muted small"><t t-esc="o.librarian_id.name"/></p>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div style="border-top: 1px solid #333; margin: 0 30px; padding-top: 5px;">
                                    <p>Member Signature</p>
                                    <p class="text-muted small"><t t-esc="o.member_id.name"/></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div t-if="not o_last" class="page_break"/>
                </t>
            </div>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════
         OVERDUE REPORT
    ═══════════════════════════════════════════════════════ -->
    <template id="report_overdue_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="text-center text-danger">
                    <i class="fa fa-exclamation-triangle"/> Overdue Books Report
                </h2>
                <p class="text-center text-muted">
                    Generated on: <t t-esc="context_timestamp(datetime.datetime.now())" t-options='{"widget": "datetime"}'/>
                </p>
                <hr/>
                <table class="table table-striped table-sm">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Reference</th>
                            <th>Member</th>
                            <th>Book</th>
                            <th>Borrow Date</th>
                            <th>Due Date</th>
                            <th>Overdue Days</th>
                            <th>Fine</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="o">
                            <tr>
                                <td><t t-esc="o_index + 1"/></td>
                                <td><t t-esc="o.name"/></td>
                                <td><t t-esc="o.member_id.name"/></td>
                                <td><t t-esc="o.book_id.name"/></td>
                                <td><t t-esc="o.borrow_date" t-options='{"widget": "date"}'/></td>
                                <td><t t-esc="o.due_date" t-options='{"widget": "date"}'/></td>
                                <td class="text-danger fw-bold"><t t-esc="o.overdue_days"/></td>
                                <td><t t-esc="'%.2f' % o.fine_amount"/></td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr class="table-warning fw-bold">
                            <td colspan="6" class="text-end">Total Fines:</td>
                            <td colspan="2"><t t-esc="'%.2f' % sum(docs.mapped('fine_amount'))"/></td>
                        </tr>
                    </tfoot>
                </table>
                <p class="text-muted mt-3">
                    Total overdue items: <b><t t-esc="len(docs)"/></b>
                </p>
            </div>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════
         MEMBER CARD REPORT
    ═══════════════════════════════════════════════════════ -->
    <template id="report_member_card_document">
        <t t-call="web.external_layout">
            <div class="page">
                <t t-foreach="docs" t-as="m">
                    <!-- Card (print-sized) -->
                    <div class="o_lib_member_card_print d-inline-block m-2">
                        <div class="o_lib_member_card_front">
                            <div class="o_lib_card_header">
                                <span class="o_lib_card_logo"><i class="fa fa-book"/> Library Card</span>
                                <span class="badge bg-light text-dark"><t t-esc="m.membership_type.upper()"/></span>
                            </div>
                            <div class="o_lib_card_body">
                                <div class="o_lib_card_photo">
                                    <img t-if="m.image" t-att-src="image_data_uri(m.image)"
                                         style="width:60px;height:60px;border-radius:50%;object-fit:cover" alt="Photo"/>
                                    <div t-else="" style="width:60px;height:60px;border-radius:50%;background:#7c7bad;display:flex;align-items:center;justify-content:center;">
                                        <i class="fa fa-user" style="color:#fff;font-size:1.5rem"/>
                                    </div>
                                </div>
                                <div class="o_lib_card_info">
                                    <h5><t t-esc="m.name"/></h5>
                                    <p class="mb-0"><b>ID:</b> <t t-esc="m.member_ref"/></p>
                                    <p class="mb-0"><b>Valid Until:</b> <t t-esc="m.membership_end" t-options='{"widget":"date"}' t-if="m.membership_end"/></p>
                                    <p class="mb-0 small text-muted"><t t-esc="m.email or ''"/></p>
                                </div>
                            </div>
                            <div class="o_lib_card_footer">
                                <span class="small">mate4tech Library System</span>
                                <span class="small"><t t-esc="m.barcode or m.member_ref"/></span>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>
