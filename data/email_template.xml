<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Due Date Reminder Email -->
    <record id="email_template_due_reminder" model="mail.template">
        <field name="name">Library: Due Date Reminder</field>
        <field name="model_id" ref="model_library_borrowing"/>
        <field name="subject">Reminder: Book Return Due – {{ object.book_id.name }}</field>
        <field name="email_to">{{ object.member_id.email }}</field>
        <field name="email_from">{{ (user.email_formatted or user.company_id.email) }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                <div style="background: linear-gradient(135deg, #4a4580, #7c7bad); padding: 24px; border-radius: 8px 8px 0 0; text-align: center;">
                    <h2 style="color: #fff; margin: 0;">📚 Library Reminder</h2>
                </div>
                <div style="padding: 24px; border: 1px solid #e0e0e0; border-radius: 0 0 8px 8px;">
                    <p>Dear <strong>{{ object.member_id.name }}</strong>,</p>
                    <p>This is a friendly reminder that the following book is due for return <strong>tomorrow</strong>:</p>
                    <div style="background: #f5f5fa; padding: 16px; border-radius: 8px; margin: 16px 0;">
                        <p><strong>📖 Book:</strong> {{ object.book_id.name }}</p>
                        <p><strong>📅 Due Date:</strong> {{ object.due_date }}</p>
                        <p><strong>🔖 Borrowing Ref:</strong> {{ object.name }}</p>
                    </div>
                    <p>Please return the book by <strong>{{ object.due_date }}</strong> to avoid late fees ({{ object.fine_per_day }} per day).</p>
                    <p>If you need more time, you may request a renewal from the library (max {{ object.max_renewals }} renewals).</p>
                    <hr/>
                    <p style="color: #888; font-size: 12px;">
                        This is an automated message from the Library Management System.<br/>
                        Please contact us at <a href="mailto:sales@mate4tech.com.au">sales@mate4tech.com.au</a>
                    </p>
                </div>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Overdue Notice Email -->
    <record id="email_template_overdue_notice" model="mail.template">
        <field name="name">Library: Overdue Book Notice</field>
        <field name="model_id" ref="model_library_borrowing"/>
        <field name="subject">⚠ Overdue Book Notice – {{ object.book_id.name }}</field>
        <field name="email_to">{{ object.member_id.email }}</field>
        <field name="email_from">{{ (user.email_formatted or user.company_id.email) }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                <div style="background: #dc3545; padding: 24px; border-radius: 8px 8px 0 0; text-align: center;">
                    <h2 style="color: #fff; margin: 0;">⚠ Overdue Book Notice</h2>
                </div>
                <div style="padding: 24px; border: 1px solid #e0e0e0; border-radius: 0 0 8px 8px;">
                    <p>Dear <strong>{{ object.member_id.name }}</strong>,</p>
                    <p>The following book is <strong style="color: #dc3545;">overdue</strong> and an accruing fine has been applied:</p>
                    <div style="background: #fff5f5; padding: 16px; border-radius: 8px; margin: 16px 0; border-left: 4px solid #dc3545;">
                        <p><strong>📖 Book:</strong> {{ object.book_id.name }}</p>
                        <p><strong>📅 Was Due:</strong> {{ object.due_date }}</p>
                        <p><strong>📆 Overdue Days:</strong> {{ object.overdue_days }}</p>
                        <p><strong>💰 Current Fine:</strong> {{ '%.2f' % object.fine_amount }}</p>
                    </div>
                    <p>Please return the book <strong>immediately</strong> to prevent further charges.</p>
                    <p>Contact us to discuss arrangements if needed.</p>
                    <hr/>
                    <p style="color: #888; font-size: 12px;">
                        Library Management System | mate4tech<br/>
                        <a href="mailto:sales@mate4tech.com.au">sales@mate4tech.com.au</a>
                    </p>
                </div>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

    <!-- Welcome Member Email -->
    <record id="email_template_welcome_member" model="mail.template">
        <field name="name">Library: Welcome New Member</field>
        <field name="model_id" ref="model_library_member"/>
        <field name="subject">Welcome to the Library, {{ object.name }}!</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="email_from">{{ (user.email_formatted or user.company_id.email) }}</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                <div style="background: linear-gradient(135deg, #4a4580, #7c7bad); padding: 24px; border-radius: 8px 8px 0 0; text-align: center;">
                    <h2 style="color: #fff; margin: 0;">📚 Welcome to the Library!</h2>
                </div>
                <div style="padding: 24px; border: 1px solid #e0e0e0; border-radius: 0 0 8px 8px;">
                    <p>Dear <strong>{{ object.name }}</strong>,</p>
                    <p>Welcome! Your library membership has been created successfully.</p>
                    <div style="background: #f5f5fa; padding: 16px; border-radius: 8px; margin: 16px 0;">
                        <p><strong>🆔 Member ID:</strong> {{ object.member_ref }}</p>
                        <p><strong>🏷 Membership Type:</strong> {{ object.membership_type }}</p>
                        <p><strong>📅 Valid Until:</strong> {{ object.membership_end or 'Unlimited' }}</p>
                        <p><strong>📚 Borrow Limit:</strong> {{ object.max_books_allowed }} books at a time</p>
                    </div>
                    <p>You can now borrow up to <strong>{{ object.max_books_allowed }}</strong> books at a time.</p>
                    <p>Visit us anytime during library hours. Happy reading! 📖</p>
                    <hr/>
                    <p style="color: #888; font-size: 12px;">
                        Library Management System | mate4tech<br/>
                        <a href="https://www.mate4tech.com.au">mate4tech.com.au</a> | <a href="mailto:sales@mate4tech.com.au">sales@mate4tech.com.au</a>
                    </p>
                </div>
            </div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>

</odoo>
