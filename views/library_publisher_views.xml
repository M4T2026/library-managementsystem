<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Publisher List View -->
    <record id="library_publisher_view_list" model="ir.ui.view">
        <field name="name">library.publisher.view.list</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <list string="Publishers" decoration-muted="not active">
                <field name="image" widget="image" options="{'size': [32, 32]}"/>
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="book_count"/>
            </list>
        </field>
    </record>

    <!-- Publisher Form View -->
    <record id="library_publisher_view_form" model="ir.ui.view">
        <field name="name">library.publisher.view.form</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <form string="Publisher">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_books" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="book_count" widget="statinfo" string="Books"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Publisher Name"/></h1>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="website" widget="url"/>
                        </group>
                        <group string="Address">
                            <field name="street"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                            <field name="zip"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Publisher Search View -->
    <record id="library_publisher_view_search" model="ir.ui.view">
        <field name="name">library.publisher.view.search</field>
        <field name="model">library.publisher</field>
        <field name="arch" type="xml">
            <search string="Search Publishers">
                <field name="name"/>
                <field name="email"/>
                <field name="city"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                    <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Publisher Action -->
    <record id="library_publisher_action" model="ir.actions.act_window">
        <field name="name">Publishers</field>
        <field name="res_model">library.publisher</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="library_publisher_view_search"/>
    </record>

</odoo>
