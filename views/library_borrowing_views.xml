<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Borrowing List View -->
    <record id="library_borrowing_view_list" model="ir.ui.view">
        <field name="name">library.borrowing.view.list</field>
        <field name="model">library.borrowing</field>
        <field name="arch" type="xml">
            <list string="Borrowings"
                  decoration-warning="state == 'overdue'"
                  decoration-success="state == 'returned'"
                  decoration-danger="state == 'lost'">
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="borrow_date"/>
                <field name="due_date"/>
                <field name="return_date" optional="show"/>
                <field name="overdue_days" optional="show"/>
                <field name="fine_amount" widget="monetary" optional="show"/>
                <field name="fine_paid" optional="show"/>
                <field name="renewal_count" optional="show"/>
                <field name="librarian_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'returned'"
                       decoration-warning="state == 'overdue'"
                       decoration-danger="state == 'lost'"/>
                <button name="action_return" string="Return" type="object"
                        class="btn-sm btn-primary"
                        invisible="state not in ['borrowed', 'overdue']"/>
            </list>
        </field>
    </record>

    <!-- Borrowing Form View -->
    <record id="library_borrowing_view_form" model="ir.ui.view">
        <field name="name">library.borrowing.view.form</field>
        <field name="model">library.borrowing</field>
        <field name="arch" type="xml">
            <form string="Borrowing">
                <header>
                    <button name="action_borrow" string="Confirm Borrow"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_return" string="Return Book"
                            type="object" class="btn-success"
                            invisible="state not in ['borrowed', 'overdue']"/>
                    <button name="action_mark_lost" string="Mark as Lost"
                            type="object" class="btn-danger"
                            invisible="state not in ['borrowed', 'overdue']"/>
                    <button name="action_pay_fine" string="Mark Fine Paid"
                            type="object" class="btn-warning"
                            invisible="fine_amount == 0 or fine_paid"/>
                    <button name="action_print_slip" string="Print Slip"
                            type="object" class="btn-secondary" icon="fa-print"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,borrowed,overdue,returned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-refresh">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="renewal_count"/></span>
                                <span class="o_stat_text">Renewals</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-clock-o"
                                invisible="overdue_days == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value text-danger"><field name="overdue_days"/></span>
                                <span class="o_stat_text">Overdue Days</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label class="o_form_label" for="name">Reference</label>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Borrowing Details">
                            <field name="member_id" options="{'no_create': True}"/>
                            <field name="book_id" options="{'no_create': True}"/>
                            <field name="book_author_ids" widget="many2many_tags" readonly="1"/>
                            <field name="book_category_id" readonly="1"/>
                        </group>
                        <group string="Dates">
                            <field name="borrow_date"/>
                            <field name="due_date"/>
                            <field name="return_date" readonly="1"/>
                            <field name="overdue_days" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Renewal">
                            <field name="renewal_count" readonly="1"/>
                            <field name="max_renewals"/>
                            <field name="can_renew" readonly="1"/>
                        </group>
                        <group string="Fine">
                            <field name="fine_per_day"/>
                            <field name="fine_amount" readonly="1" widget="monetary"/>
                            <field name="fine_paid" widget="boolean_toggle"
                                   invisible="fine_amount == 0"/>
                        </group>
                    </group>
                    <group string="Other">
                        <field name="librarian_id"/>
                        <field name="notes" placeholder="Internal notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Borrowing Search View -->
    <record id="library_borrowing_view_search" model="ir.ui.view">
        <field name="name">library.borrowing.view.search</field>
        <field name="model">library.borrowing</field>
        <field name="arch" type="xml">
            <search string="Search Borrowings">
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <separator/>
                <filter string="Active (Borrowed)" name="borrowed" domain="[('state','=','borrowed')]"/>
                <filter string="Overdue" name="overdue" domain="[('state','=','overdue')]"/>
                <filter string="Returned" name="returned" domain="[('state','=','returned')]"/>
                <filter string="Lost" name="lost" domain="[('state','=','lost')]"/>
                <separator/>
                <filter string="Unpaid Fines" name="unpaid_fines"
                        domain="[('fine_amount','>',0),('fine_paid','=',False)]"/>
                <filter string="Today's Returns" name="today_returns"
                        domain="[('return_date','=',context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Due Today" name="due_today"
                        domain="[('due_date','=',context_today().strftime('%Y-%m-%d')),('state','=','borrowed')]"/>
                <group expand="1" string="Group By">
                    <filter string="Member" name="group_member" context="{'group_by': 'member_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Borrow Date" name="group_date" context="{'group_by': 'borrow_date:month'}"/>
                    <filter string="Librarian" name="group_librarian" context="{'group_by': 'librarian_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Borrowing Calendar View -->
    <record id="library_borrowing_view_calendar" model="ir.ui.view">
        <field name="name">library.borrowing.view.calendar</field>
        <field name="model">library.borrowing</field>
        <field name="arch" type="xml">
            <calendar string="Borrowing Calendar" date_start="borrow_date"
                      date_stop="due_date" color="state" mode="month" quick_create="0">
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Borrowing Action (All) -->
    <record id="library_borrowing_action" model="ir.actions.act_window">
        <field name="name">Borrowings</field>
        <field name="res_model">library.borrowing</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="search_view_id" ref="library_borrowing_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No borrowings yet!</p>
            <p>Use the Borrow Book wizard to issue books to members.</p>
        </field>
    </record>

    <!-- Borrowing Action (Overdue) -->
    <record id="library_borrowing_overdue_action" model="ir.actions.act_window">
        <field name="name">Overdue Borrowings</field>
        <field name="res_model">library.borrowing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','overdue')]</field>
        <field name="search_view_id" ref="library_borrowing_view_search"/>
        <field name="context">{'search_default_overdue': 1}</field>
    </record>

    <!-- Borrowing Action (Active) -->
    <record id="library_borrowing_active_action" model="ir.actions.act_window">
        <field name="name">Active Borrowings</field>
        <field name="res_model">library.borrowing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','in',['borrowed','overdue'])]</field>
        <field name="search_view_id" ref="library_borrowing_view_search"/>
    </record>

</odoo>
