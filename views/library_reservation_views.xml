<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reservation List View -->
    <record id="library_reservation_view_list" model="ir.ui.view">
        <field name="name">library.reservation.view.list</field>
        <field name="model">library.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations"
                  decoration-warning="state == 'reserved'"
                  decoration-success="state == 'confirmed'"
                  decoration-muted="state in ('cancelled', 'expired')">
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <field name="reservation_date"/>
                <field name="expiry_date"/>
                <field name="state" widget="badge"/>
                <button name="action_confirm" string="Confirm" type="object"
                        class="btn-sm btn-success" invisible="state != 'reserved'"/>
                <button name="action_convert_to_borrowing" string="Issue Book" type="object"
                        class="btn-sm btn-primary" invisible="state != 'confirmed'"/>
                <button name="action_cancel" string="Cancel" type="object"
                        class="btn-sm btn-danger"
                        invisible="state in ('cancelled', 'expired', 'confirmed')"/>
            </list>
        </field>
    </record>

    <!-- Reservation Form View -->
    <record id="library_reservation_view_form" model="ir.ui.view">
        <field name="name">library.reservation.view.form</field>
        <field name="model">library.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_confirm" string="Confirm Reservation"
                            type="object" class="btn-success" invisible="state != 'reserved'"/>
                    <button name="action_convert_to_borrowing" string="Issue Book"
                            type="object" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-danger"
                            invisible="state in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="reserved,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="member_id"/>
                            <field name="book_id"/>
                        </group>
                        <group>
                            <field name="reservation_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Reservation Search View -->
    <record id="library_reservation_view_search" model="ir.ui.view">
        <field name="name">library.reservation.view.search</field>
        <field name="model">library.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="member_id"/>
                <field name="book_id"/>
                <filter string="Active" name="active_res" domain="[('state','=','reserved')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state','=','confirmed')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
            </search>
        </field>
    </record>

    <!-- Reservation Action -->
    <record id="library_reservation_action" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">library.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_res': 1}</field>
        <field name="search_view_id" ref="library_reservation_view_search"/>
    </record>

</odoo>
